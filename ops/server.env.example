# Mazge inference server config — copy to ~/.config/mazge/server.env on the
# host running the server, then `launchctl kickstart -k gui/$(id -u)/com.mazge.server`.

MAZGE_MODEL_BACKEND=onnx
MAZGE_YOLO_ONNX=/Users/tomas/Mazge/_bench_weights/yolo11s_480.onnx
MAZGE_PREY_ONNX=/Users/tomas/Mazge/_bench_weights/prey_v3_bodyA_s480_224.onnx
MAZGE_YOLO_IMGSZ=480
MAZGE_THREADS=2
MAZGE_PORT=8080
MAZGE_LOG_DIR=/Users/tomas/Mazge/logs/server

# Mosquitto bridge — leave empty to disable until the broker is up.
MAZGE_MQTT_HOST=
MAZGE_MQTT_PORT=1883
MAZGE_MQTT_USER=
MAZGE_MQTT_PASS=

# ESP32 web-UI reverse proxy — leave MAZGE_ESP_HOST empty to disable.
# When set, a second uvicorn server runs on MAZGE_ESP_PROXY_PORT and forwards
# every request to http://$MAZGE_ESP_HOST (stream on :81 is intentionally not
# proxied). Browse via http://mazge:<port>/ over Tailscale.
MAZGE_ESP_HOST=
MAZGE_ESP_PROXY_PORT=8081
