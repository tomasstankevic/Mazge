// secrets.h.example — Template for secrets.h
// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored and will not be committed.

#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID "your_wifi_ssid"
#define WIFI_PASS "your_wifi_password"

// v2 LAN inference server (REQUIRED — v1 cloud is removed in this firmware).
// Server is mazge/server/app.py running on the same WiFi. Plain HTTP.
// If unreachable, the door fails CLOSED with a 120s lockout so the cat can
// retry on the next ToF trigger.
#define PREY_V2_URL "http://192.168.0.134:8080/v2/frame"
#define PREY_V2_DEVICE_ID "mazge-frontdoor-01"

// OPTIONAL: Blynk IoT credentials. If undefined, Blynk calls become no-ops.
#define BLYNK_TEMPLATE_ID   "your_blynk_template_id"
#define BLYNK_TEMPLATE_NAME "Cat camera"
#define BLYNK_AUTH_TOKEN    "your_blynk_auth_token"

#endif
